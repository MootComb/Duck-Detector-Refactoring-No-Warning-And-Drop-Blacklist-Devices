<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- The manifest merger gives this attribute to a host that declares none. A host with its own
         preload gets a merge conflict instead, keeps its class with tools:replace and delegates to
         DuckDetectorZygotePreload, so the SDK's app zygote work is never dropped silently. -->
    <application android:zygotePreloadName="com.eltavine.duckdetector.sdk.DuckDetectorZygotePreload" />

</manifest>

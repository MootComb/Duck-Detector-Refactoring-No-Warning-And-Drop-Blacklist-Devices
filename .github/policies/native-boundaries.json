{
  "schema_version": 1,
  "source_root": "app/src/main/cpp",
  "cmake_lists": "app/src/main/cpp/CMakeLists.txt",
  "unit_function": "duckdetector_native_unit",
  "aggregate_library": "duckdetector",
  "units": {
    "common": {
      "path": "common",
      "owner": ":core:native",
      "target": "duckdetector_common",
      "may_include": []
    },
    "tee": {
      "path": "tee",
      "owner": ":feature:tee:data",
      "target": "duckdetector_tee",
      "may_include": ["common"]
    },
    "packageinventory": {
      "path": "packageinventory",
      "owner": ":capability:packageinventory:data",
      "target": "duckdetector_packageinventory",
      "may_include": ["common"]
    },
    "su": {
      "path": "su",
      "owner": ":feature:su:data",
      "target": "duckdetector_su",
      "may_include": ["common"]
    },
    "selinuxpolicy": {
      "path": "selinuxpolicy",
      "owner": ":capability:selinuxpolicy:data",
      "target": "duckdetector_selinuxpolicy",
      "may_include": ["common"]
    },
    "selinux": {
      "path": "selinux",
      "owner": ":feature:selinux:data",
      "target": "duckdetector_selinux",
      "may_include": ["common"]
    },
    "customrom": {
      "path": "customrom",
      "owner": ":feature:customrom:data",
      "target": "duckdetector_customrom",
      "may_include": ["common"]
    },
    "kernelcheck": {
      "path": "kernelcheck",
      "owner": ":feature:kernelcheck:data",
      "target": "duckdetector_kernelcheck",
      "may_include": ["common"]
    },
    "systemproperties": {
      "path": "systemproperties",
      "owner": ":capability:systemproperties:data",
      "target": "duckdetector_systemproperties",
      "may_include": ["common"]
    },
    "bootloader": {
      "path": "bootloader",
      "owner": ":feature:bootloader:data",
      "target": "duckdetector_bootloader",
      "may_include": ["common"]
    },
    "mount": {
      "path": "mount",
      "owner": ":feature:mount:data",
      "target": "duckdetector_mount",
      "may_include": ["common"]
    },
    "zygotenext": {
      "path": "mount/zygotenext",
      "owner": ":feature:mount:data",
      "target": "main",
      "may_include": ["common"]
    },
    "preload": {
      "path": "preload",
      "owner": ":capability:earlypreload:data",
      "target": "duckdetector_preload",
      "may_include": ["common"]

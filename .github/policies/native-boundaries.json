    "memory": {
      "path": "memory",
      "owner": ":feature:memory:data",
      "target": "duckdetector_memory",
      "may_include": ["common"]
    },
    "playintegrityfix": {
      "path": "playintegrityfix",
      "owner": ":feature:playintegrityfix:data",
      "target": "duckdetector_playintegrityfix",
      "may_include": ["common"]
    },
    "nativeroot": {
      "path": "nativeroot",
      "owner": ":feature:nativeroot:data",
      "target": "duckdetector_nativeroot",
      "may_include": ["common"]
    },
    "lsposed": {
      "path": "lsposed",
      "owner": ":feature:lsposed:data",
      "target": "duckdetector_lsposed",
      "may_include": ["common"]
    },
    "zygisk": {
      "path": "zygisk",
      "owner": ":feature:zygisk:data",
      "target": "duckdetector_zygisk",
      "may_include": ["common"]
    },
    "virtualization": {
      "path": "virtualization",
      "owner": ":capability:helperprocess:data",
      "target": "duckdetector_virtualization",
      "may_include": ["common"]
    }
  },
  "include_exceptions": [
    {
      "unit": "preload",
      "header": "virtualization/snapshot_builder.h",
      "reason": "The startup virtualization preload runs the same collect_snapshot probe as the runtime virtualization bridge so both snapshots come from one implementation, then reads its mount keys and finding labels. Both units link into libduckdetector.so; matching on finding labels is a text protocol tracked in docs/architecture/follow-ups.md."
    }
  ]
}

<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <application>
        <!-- The package directory watch is installed during app_zygote preload and inherited through
             fork, so this carrier only drains the event stream from the isolated child. The intent
             filter declares the MIME group the throne-hunt stimulus flips: setMimeGroup accepts only
             a group that a component of the calling package declares, whatever the component's
             type, and the filter is inert because the service is not exported. MIME groups exist
             from API 30; below it the stimulus reports itself unsupported. -->
        <service
            android:name="com.eltavine.duckdetector.features.nativeroot.data.service.ThroneHuntCarrierService"
            android:exported="false"
            android:isolatedProcess="true"
            android:useAppZygote="true">
            <intent-filter>
                <action android:name="com.eltavine.duckdetector.action.THRONE_HUNT_ANCHOR" />

                <category android:name="android.intent.category.DEFAULT" />

                <data
                    android:mimeGroup="duckdetector-throne-hunt"
                    tools:targetApi="r" />
            </intent-filter>
        </service>
    </application>

</manifest>

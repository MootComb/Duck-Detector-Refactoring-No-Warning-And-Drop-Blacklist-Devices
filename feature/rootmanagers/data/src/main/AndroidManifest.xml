<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Root Managers enumerates launcher activities, so a host inherits this visibility through the
         manifest merger, the way TEE inherits its SOTER server package entry. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

</manifest>
